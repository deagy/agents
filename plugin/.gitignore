# No Node rules here on purpose. Nothing under plugin/ is an npm package
# since the Cline workspaces moved to cline-plugins/ -- and a package.json at
# this plugin's marketplace source root is exactly what made installing it
# fetch 263 MB of node_modules. If a node_modules/ ever appears here, that is
# a defect to investigate, not something to ignore.

# Python
__pycache__/
*.pyc

# OS
.DS_Store

# Local knowledge-store runtime state (config + embeddings db)
.agents/knowledge-store/
