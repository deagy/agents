#!/bin/sh
# Entry point for this repository's `cadre` CLI. Finds a Python 3.10+
# interpreter and hands off to bin/cadre.py, which owns the subcommand
# table, sdlc delegation, usage text, and dispatch logic (kept in one place
# instead of duplicated here and in bin/cadre.ps1). Safe to invoke via a
# symlink on PATH (see README.md "System-wide install") or directly as
# ./bin/cadre from this checkout.
set -eu

# Portable symlink resolution (no GNU-only `readlink -f`): follow symlinks
# until the target is a real file, then take that file's directory.
resolve_script_dir() {
  target="$1"
  while [ -L "$target" ]; do
    dir=$(CDPATH= cd -- "$(dirname -- "$target")" && pwd)
    target=$(readlink -- "$target")
    case "$target" in
      /*) ;;
      *) target="$dir/$target" ;;
    esac
  done
  CDPATH= cd -- "$(dirname -- "$target")" && pwd
}

BIN_DIR=$(resolve_script_dir "$0")

AGENT_PYTHON=
for candidate in python3 python; do
  command -v "$candidate" >/dev/null 2>&1 || continue
  if "$candidate" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' 2>/dev/null; then
    AGENT_PYTHON="$candidate"
    break
  fi
done
[ -n "$AGENT_PYTHON" ] || { echo "cadre: Python 3.10+ is required (checked python3, python)" >&2; exit 1; }

exec "$AGENT_PYTHON" "$BIN_DIR/cadre.py" "$@"
